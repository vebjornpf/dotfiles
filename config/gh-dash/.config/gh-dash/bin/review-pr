#!/usr/bin/env bash

set -euo pipefail

repo=${1:-}
pr_number=${2:-}

if [[ -z "$repo" || ! "$pr_number" =~ ^[0-9]+$ ]]; then
  printf 'Usage: review-pr <owner/repo> <pr-number>\n' >&2
  exit 1
fi

for command in gh hunk; do
  if ! command -v "$command" >/dev/null 2>&1; then
    printf 'review-pr: %s is required\n' "$command" >&2
    exit 1
  fi
done

token=${GH_TOKEN:-${GITHUB_TOKEN:-}}
if [[ -z "$token" ]]; then
  token=$(gh auth token)
fi

GH_TOKEN=$token hunk gh pr "https://github.com/$repo/pull/$pr_number"
