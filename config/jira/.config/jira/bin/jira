#!/usr/bin/env bash

set -euo pipefail

JIRA_HOME="${JIRA_HOME:-$HOME/.config/jira}"
source "$JIRA_HOME/lib/env.sh"

usage() {
  cat <<'EOF'
Usage: jira [command]

Commands:
  jira        open or select tmux session "daily" and window "jira"
  jira auth       log acli into Jira using local Atlassian env vars
  jira backlog    open Jira backlog picker
  jira board      open configured Jira board in browser
  jira component  browse open issues by Jira component
  jira create     create a Jira work item interactively
  jira epics      open cached Jira epics picker
  jira item <KEY> view a Jira item
  jira mywork     manage my Jira work
  jira statusline print compact sync ages for tmux
  jira sync       run Jira sync
  Private variables can be set in ~/.config/local/tools.zsh:
    JIRA_PROJECT_KEY
    JIRA_BASE_URL
    JIRA_BOARD_URL
    ATLASSIAN_SITE
    ATLASSIAN_EMAIL
    ATLASSIAN_API_TOKEN
  Run `jira <command> --help` for command-specific help.
  jira --help show this help
EOF
}

if (( $# > 0 )); then
  case "$1" in
    -h|--help|help)
      usage
      exit 0
      ;;
    auth)
      shift
      exec "$JIRA_HOME/bin/jira-auth" "$@"
      ;;
    backlog)
      shift
      exec "$JIRA_HOME/bin/jira-backlog" "$@"
      ;;
    board)
      shift
      exec "$JIRA_HOME/bin/jira-board" "$@"
      ;;
    component)
      shift
      exec "$JIRA_HOME/bin/jira-component" "$@"
      ;;
    create)
      shift
      exec "$JIRA_HOME/bin/jira-create" "$@"
      ;;
    epics)
      shift
      exec "$JIRA_HOME/bin/jira-epics" "$@"
      ;;
    item)
      shift
      exec "$JIRA_HOME/bin/jira-item" "$@"
      ;;
    mywork)
      shift
      exec "$JIRA_HOME/bin/jira-mywork" "$@"
      ;;
    statusline)
      shift
      exec "$JIRA_HOME/bin/jira-statusline" "$@"
      ;;
    sync)
      shift
      exec "$JIRA_HOME/bin/jira-sync" "$@"
      ;;
    *)
      echo "Unknown jira argument: $1" >&2
      echo >&2
      usage >&2
      exit 1
      ;;
  esac
fi

exec bash "$HOME/.config/tmux/scripts/daily-window-session" jira "true"
