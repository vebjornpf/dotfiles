#!/usr/bin/env bash

set -euo pipefail

JIRA_HOME="${JIRA_HOME:-$HOME/.config/jira}"
source "$JIRA_HOME/lib/env.sh"

usage() {
  cat <<'EOF'
Usage: jira [command]

Commands:
  jira        show this help
  jira auth       log acli into Jira using local Atlassian env vars
  jira backlog    show cached Jira backlog
  jira board      open configured Jira board in browser
  jira create     create a Jira work item interactively
  jira doctor     verify local Jira setup
  jira epics      list epics or query an epic's child issues
  jira item <KEY> view a cached Jira item
  jira me         manage issues assigned to you
  jira statusline print compact sync ages for tmux
  jira sync       refresh the project cache
  jira team       show cached assigned project issues
  Private variables can be set in ~/.config/local/tools.zsh:
    JIRA_PROJECT_KEY
    JIRA_ACCOUNT_ID
    JIRA_BASE_URL
    JIRA_BOARD_URL
    ATLASSIAN_SITE
    ATLASSIAN_EMAIL
    ATLASSIAN_API_TOKEN
  Run `jira <command> --help` for command-specific help.
  jira --help show this help
EOF
}

if (( $# > 0 )); then
  case "$1" in
    -h|--help|help)
      usage
      exit 0
      ;;
    auth)
      shift
      exec "$JIRA_HOME/bin/jira-auth" "$@"
      ;;
    backlog)
      shift
      exec "$JIRA_HOME/bin/jira-backlog" "$@"
      ;;
    doctor)
      shift
      exec bash "$JIRA_HOME/lib/doctor.sh" "$@"
      ;;
    board)
      shift
      exec "$JIRA_HOME/bin/jira-board" "$@"
      ;;
    team)
      shift
      exec "$JIRA_HOME/bin/jira-team" "$@"
      ;;
    create)
      shift
      exec "$JIRA_HOME/bin/jira-create" "$@"
      ;;
    epics)
      shift
      exec "$JIRA_HOME/bin/jira-epics" "$@"
      ;;
    item)
      shift
      exec "$JIRA_HOME/bin/jira-item" "$@"
      ;;
    me)
      shift
      exec "$JIRA_HOME/bin/jira-me" "$@"
      ;;
    statusline)
      shift
      exec "$JIRA_HOME/bin/jira-statusline" "$@"
      ;;
    sync)
      shift
      exec "$JIRA_HOME/bin/jira-sync" "$@"
      ;;
    *)
      echo "Unknown jira argument: $1" >&2
      echo >&2
      usage >&2
      exit 1
      ;;
  esac
fi

usage
