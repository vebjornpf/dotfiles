#!/usr/bin/env bash

set -euo pipefail

JIRA_HOME="${JIRA_HOME:-$HOME/.config/jira}"
source "$JIRA_HOME/lib/env.sh"

usage() {
  cat <<'EOF'
Usage: jira [command]

Commands:
  jira        open or select tmux session "daily" and window "jira"
  jira backlog open Jira backlog picker
  jira board  open configured Jira board in browser
  jira board open
  jira mywork open Jira my work picker
  jira mywork list
  jira mywork status
  jira mywork <KEY>
  jira mywork <KEY> open
  jira mywork <KEY> cp
  jira mywork <KEY> cpk
  jira sync   run Jira sync
  jira sync mywork
  jira sync backlog
  Private variables can be set in ~/.config/local/jira.zsh:
    JIRA_BASE_URL
    JIRA_BOARD_URL
    JIRA_BACKLOG_JQL
  jira --help show this help
EOF
}

open_url() {
  local url="$1"

  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url" >/dev/null 2>&1 &
  elif command -v open >/dev/null 2>&1; then
    open "$url" >/dev/null 2>&1 &
  else
    echo "No supported browser opener found (xdg-open/open)" >&2
    exit 1
  fi
}

open_board() {
  require_jira_board_url
  open_url "$JIRA_BOARD_URL"
}

if (( $# > 0 )); then
  case "$1" in
    -h|--help|help)
      usage
      exit 0
      ;;
    backlog)
      shift
      bash "$JIRA_HOME/lib/pick.sh" backlog "Jira Backlog"
      exit 0
      ;;
    board)
      shift
      case "${1:-}" in
        ""|open)
          open_board
          ;;
        *)
          echo "Unknown jira board argument: $1" >&2
          echo >&2
          echo "Usage: jira board" >&2
          echo "       jira board open" >&2
          exit 1
          ;;
      esac
      exit 0
      ;;
    mywork)
      shift
      case "${1:-}" in
        "")
          bash "$JIRA_HOME/lib/pick.sh" mywork "Jira My Work"
          ;;
        list)
          bash "$JIRA_HOME/lib/mywork-list.sh"
          ;;
        status)
          bash "$JIRA_HOME/lib/mywork-status.sh"
          ;;
        [A-Z][A-Z0-9]*-[0-9]*)
          bash "$JIRA_HOME/lib/item.sh" "$1" "${2:-view}"
          ;;
        *)
          echo "Unknown jira mywork argument: $1" >&2
          echo >&2
          echo "Usage: jira mywork" >&2
          echo "       jira mywork list" >&2
          echo "       jira mywork status" >&2
          echo "       jira mywork <KEY>" >&2
          echo "       jira mywork <KEY> open" >&2
          echo "       jira mywork <KEY> cp" >&2
          echo "       jira mywork <KEY> cpk" >&2
          exit 1
          ;;
      esac
      exit 0
      ;;
    sync)
      shift
      bash "$JIRA_HOME/lib/sync.sh" "$@"
      exit 0
      ;;
    *)
      echo "Unknown jira argument: $1" >&2
      echo >&2
      usage >&2
      exit 1
      ;;
  esac
fi

bash "$HOME/.config/tmux/scripts/daily-window-session" jira "true"
