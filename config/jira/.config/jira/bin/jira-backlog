#!/usr/bin/env bash

set -euo pipefail

JIRA_HOME="${JIRA_HOME:-$HOME/.config/jira}"

usage() {
  cat <<'EOF'
Usage: jira backlog [list|picker]

  jira backlog        show this help
  jira backlog list   print cached backlog issues
  jira backlog picker open the cached interactive picker
EOF
}

case "${1:-}" in
  ""|-h|--help|help) usage ;;
  list|picker)
    command="$1"
    shift
    exec bash "$JIRA_HOME/lib/view-command.sh" backlog "$command" "$@"
    ;;
  *) echo "Unknown jira backlog argument: $1" >&2; usage >&2; exit 1 ;;
esac
