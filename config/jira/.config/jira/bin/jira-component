#!/usr/bin/env bash

set -euo pipefail

JIRA_HOME="${JIRA_HOME:-$HOME/.config/jira}"

usage() {
  cat <<'EOF'
Usage: jira component [command]

Commands:
  jira component        pick a Jira component and browse its open issues
  jira component sync   sync component list from Jira API to components.tsv
  jira component --help show this help
EOF
}

case "${1:-}" in
  "")
    exec bash "$JIRA_HOME/lib/component-pick.sh"
    ;;
  sync)
    exec bash "$JIRA_HOME/lib/component-sync.sh"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown jira component argument: $1" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac
