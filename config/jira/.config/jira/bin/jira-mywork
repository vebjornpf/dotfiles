#!/usr/bin/env bash

set -euo pipefail

JIRA_HOME="${JIRA_HOME:-$HOME/.config/jira}"

usage() {
  cat <<'EOF'
Usage: jira mywork [command]

Commands:
  jira mywork        open Jira my work picker
  jira mywork list
  jira mywork status
  jira mywork <KEY>
  jira mywork <KEY> open
  jira mywork <KEY> cp
  jira mywork <KEY> cpk
  jira mywork --help show this help
EOF
}

case "${1:-}" in
  "")
    exec bash "$JIRA_HOME/lib/pick.sh" mywork "Jira My Work"
    ;;
  -h|--help|help)
    usage
    ;;
  list)
    shift
    if (( $# > 0 )); then
      echo "Unknown jira mywork list argument: $1" >&2
      echo >&2
      echo "Usage: jira mywork list" >&2
      exit 1
    fi
    exec bash "$JIRA_HOME/lib/mywork-list.sh"
    ;;
  status)
    shift
    if (( $# > 0 )); then
      echo "Unknown jira mywork status argument: $1" >&2
      echo >&2
      echo "Usage: jira mywork status" >&2
      exit 1
    fi
    exec bash "$JIRA_HOME/lib/mywork-status.sh"
    ;;
  [A-Z][A-Z0-9]*-[0-9]*)
    key="$1"
    shift
    exec "$JIRA_HOME/bin/jira-item" "$key" "$@"
    ;;
  *)
    echo "Unknown jira mywork argument: $1" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac
