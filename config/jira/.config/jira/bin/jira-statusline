#!/usr/bin/env bash

set -euo pipefail

JIRA_HOME="${JIRA_HOME:-$HOME/.config/jira}"

usage() {
  cat <<'EOF'
Usage: jira statusline

Commands:
  jira statusline        print compact sync ages for tmux
  jira statusline --help show this help
EOF
}

case "${1:-}" in
  "")
    exec bash "$JIRA_HOME/lib/statusline-sync.sh"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown jira statusline argument: $1" >&2
    echo >&2
    usage >&2
    exit 1
    ;;
esac
