{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "references": {
    "git": {
      "path": "~/git",
      "description": "Local git checkout root. Safe to read for context across repositories."
    }
  },
  "permission": {
    "external_directory": {
      "*": "ask",
      "~/git/**": "allow"
    },
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "bash": {
      "acli *": "ask",
      "*": "allow",
      "git commit*": "ask",
      "gh pr create*": "deny",
      "gh api *pulls*": "deny"
    }
  }
}
