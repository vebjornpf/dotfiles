#!/usr/bin/env bash

set -euo pipefail

window_name="${1:-}"
window_command="${2:-}"
session="daily"
session_path="$HOME/git/daily"

if [[ -z "$window_name" || -z "$window_command" ]]; then
  echo "Usage: daily-window-session <window-name> <command>" >&2
  exit 1
fi

if ! tmux has-session -t="$session" 2>/dev/null; then
  tmux new-session -ds "$session" -c "$session_path"
fi

if tmux list-windows -t "$session" -F '#{window_name}' 2>/dev/null | grep -qx "$window_name"; then
  tmux select-window -t "$session:$window_name"
else
  tmux new-window -t "$session" -n "$window_name" -c "$session_path"
  tmux send-keys -t "$session:$window_name" "$window_command" Enter
fi

if [[ "${TMUX-}" != '' ]]; then
  tmux switch-client -t "$session"
else
  tmux attach -t "$session"
fi
