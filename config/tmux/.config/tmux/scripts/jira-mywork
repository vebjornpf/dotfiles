#!/usr/bin/env bash

set -euo pipefail

SCRIPTS_DIR="$(dirname "$0")"
LIST_SCRIPT="$SCRIPTS_DIR/jira-mywork-list.sh"
PREVIEW_SCRIPT="$SCRIPTS_DIR/jira-mywork-preview.sh"
SYNC_SCRIPT="$HOME/.config/zsh/scripts/jira-sync.sh"
bash "$SYNC_SCRIPT" mywork

while true; do
  selected=$(fzf --ansi --prompt="Jira My Work > " \
    --delimiter='\t' --with-nth=1 \
    --header=$'enter: open in web | alt-r: refresh | alt-c: copy key | alt-u: copy url' \
    --preview "bash $PREVIEW_SCRIPT {6}" \
    --preview-window=up:75% \
    --phony --bind "start:reload(bash $LIST_SCRIPT)" \
    --bind "alt-r:reload(bash $SYNC_SCRIPT mywork >/dev/null && bash $LIST_SCRIPT)" \
    --bind "enter:execute-silent(acli jira workitem view {2} --web)+abort" \
    --bind "alt-c:execute-silent(printf '%s' {2} | xclip -selection clipboard)" \
    --bind "alt-u:execute-silent(printf '%s' {5} | xclip -selection clipboard)" )

  [[ -z "$selected" ]] && break
done
