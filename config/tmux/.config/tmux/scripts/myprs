#!/usr/bin/env bash

SCRIPTS_DIR="$(dirname "$0")"
fetch_cmd="bash $SCRIPTS_DIR/myprs-fetch.sh"

while true; do
  selected=$(fzf --ansi --prompt="My PRs > " \
    --delimiter='\t' --with-nth=1,2,3 \
    --header=$'enter: open in nvim | alt-o: open in web | alt-a: approve | alt-m: merge | alt-d: toggle draft | alt-c: copy URL | alt-r: reload' \
    --preview "bash $SCRIPTS_DIR/myprs-preview.sh {4}" \
    --preview-window=up:75% \
    --phony --bind "start:reload($fetch_cmd)" \
    --bind "alt-r:reload($fetch_cmd)" \
    --bind "alt-o:execute-silent(gh pr view {1} --repo \$(printf '%s' {4} | base64 --decode | jq -r '.repository.nameWithOwner') --web)" \
    --bind "alt-a:execute-silent(gh pr review {1} --repo \$(printf '%s' {4} | base64 --decode | jq -r '.repository.nameWithOwner') --approve)+reload($fetch_cmd)" \
    --bind "alt-m:execute-silent(gh pr merge --squash --repo \$(printf '%s' {4} | base64 --decode | jq -r '.repository.nameWithOwner') {1})+reload($fetch_cmd)" \
    --bind "alt-d:execute-silent(bash -c 'repo=\$(printf \"%s\" {4} | base64 --decode | jq -r \".repository.nameWithOwner\"); draft=\$(printf \"%s\" {4} | base64 --decode | jq -r \".isDraft\"); if [[ \"\$draft\" == \"true\" ]]; then gh pr ready {1} --repo \"\$repo\"; else gh pr ready --undo {1} --repo \"\$repo\"; fi')+reload($fetch_cmd)" \
    --bind "alt-c:execute-silent(gh pr view {1} --repo \$(printf '%s' {4} | base64 --decode | jq -r '.repository.nameWithOwner') --json url -q .url | xclip -selection clipboard)" \
    --expect=enter)

  key=$(printf '%s' "$selected" | head -1)
  line=$(printf '%s' "$selected" | tail -n +2)

  [[ -z "$line" ]] && break

  pr_number=$(printf '%s' "$line" | cut -f1)
  payload=$(printf '%s' "$line" | cut -f4)
  branch=$(printf '%s' "$payload" | base64 --decode | jq -r '.headRefName')
  repo=$(printf '%s' "$payload" | base64 --decode | jq -r '.repository.nameWithOwner')

  bash "$SCRIPTS_DIR/ghpr-open.sh" "$repo" "$pr_number" "$branch"
  break  # session switched → close popup
done
