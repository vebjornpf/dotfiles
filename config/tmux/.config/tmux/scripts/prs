#!/usr/bin/env bash

SCRIPTS_DIR="$(dirname "$0")"
load_cmd="bash $SCRIPTS_DIR/assignedprs-grouped-cache.sh ensure"
refresh_cmd="bash $SCRIPTS_DIR/assignedprs-grouped-cache.sh refresh"

while true; do
  data=$(eval "$load_cmd")

  selected=$(printf '%s' "$data" | fzf --ansi --prompt="Repos > " \
    --delimiter='\t' --with-nth=1 \
    --header=$'enter: view PRs | alt-s: switch session | alt-r: refresh' \
    --preview "bash $SCRIPTS_DIR/assignedprs-grouped-preview.sh {4}" \
    --preview-window=up:75% \
    --bind "alt-r:reload($refresh_cmd)" \
    --expect=enter,alt-s)

  key=$(printf '%s' "$selected" | head -1)
  line=$(printf '%s' "$selected" | tail -n +2)

  [[ -z "$line" ]] && break  # esc → exit

  repo_full=$(printf '%s' "$line" | cut -f2)

  if [[ "$key" == "alt-s" ]]; then
    bash "$SCRIPTS_DIR/assignedprs-open.sh" "$repo_full"
    break  # close popup after switching session
  else
    bash "$SCRIPTS_DIR/ghpr" "$repo_full"
  fi
done
