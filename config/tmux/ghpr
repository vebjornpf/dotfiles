#!/usr/bin/env bash

SCRIPTS_DIR="$(dirname "$0")/scripts"
repo_full="${1:-}"
repo_flag=""
if [[ -n "$repo_full" ]]; then
  repo_flag="--repo $repo_full"
fi

fetch_cmd="bash $SCRIPTS_DIR/ghpr-fetch.sh $repo_full"

fzf --ansi --prompt="Select PR > " \
  --delimiter='\t' --with-nth=1,2,3 \
  --header=$'alt-o: open in web | alt-b: checkout | alt-a: approve | alt-m: merge | alt-c: copy URL | alt-r: reload' \
  --preview "bash $SCRIPTS_DIR/ghpr-preview.sh {4}" \
  --preview-window=up:75% \
  --phony --bind "start:reload($fetch_cmd)" \
  --bind "alt-r:reload($fetch_cmd)" \
  --bind "alt-b:execute(gh pr checkout $repo_flag {1})+abort" \
  --bind "alt-o:execute-silent(gh pr view {1} $repo_flag --web)" \
  --bind "alt-a:execute-silent(gh pr review {1} $repo_flag --approve)+reload($fetch_cmd)" \
  --bind "alt-m:execute-silent(gh pr merge --squash $repo_flag {1})+reload($fetch_cmd)" \
  --bind "alt-c:execute-silent(gh pr view {1} $repo_flag --json url -q .url | xclip -selection clipboard)"
